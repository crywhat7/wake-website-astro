# Analitica del sitio (opcional: sin estas variables el sitio funciona igual,
# pero no se mide nada). Copiar a .env y rellenar.

# Google Analytics 4 — ID de flujo web (Admin > Flujos de datos)
PUBLIC_GA_ID=

# Microsoft Clarity — mapas de calor y grabaciones de sesion (clarity.microsoft.com)
PUBLIC_CLARITY_ID=
