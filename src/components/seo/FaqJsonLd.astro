---
interface Props {
  items: Array<{ q: string; a: string }>;
}

const { items } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

{items.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
