---
import {
  PRICING,
  SEO,
  SITE,
  activeSocialLinks,
  healthPriceLabel,
  healthPriceRaw,
} from '../../data/site';
import type { Locale, PageKey } from '../../i18n';
import { getLocalizedPath, t } from '../../i18n';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const dict = t(locale);
const siteUrl = (Astro.site?.href ?? SITE.url).replace(/\/$/, '');
const homeUrl = new URL(getLocalizedPath('home', locale), `${siteUrl}/`).href;
const healthUrl = new URL(getLocalizedPath('health', locale), `${siteUrl}/`).href;

/* Google pide el logo como ImageObject con medidas y en formato raster;
   un SVG suelto se ignora en los resultados enriquecidos. */
const logo = {
  '@type': 'ImageObject',
  url: new URL('icon-512.png', `${siteUrl}/`).href,
  width: 512,
  height: 512,
  caption: SITE.name,
};
const ogImage = new URL(
  (locale === 'en' ? SEO.ogImageEn : SEO.ogImage).replace(/^\//, ''),
  `${siteUrl}/`,
).href;

const organization = {
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: SITE.name,
  url: siteUrl,
  email: SITE.email,
  logo,
  image: ogImage,
  description: dict.home.seo.description,
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'HN',
    addressRegion: 'Francisco Morazán',
    addressLocality: 'Tegucigalpa',
  },
  areaServed: [
    { '@type': 'Country', name: 'Honduras' },
    { '@type': 'Place', name: 'Central America' },
    { '@type': 'Place', name: 'Latin America' },
    { '@type': 'Country', name: 'United States' },
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: `+${SITE.whatsapp}`,
    contactType: 'sales',
    availableLanguage: ['Spanish', 'English'],
    areaServed: ['HN', 'US', 'LATAM'],
  },
  foundingDate: String(SITE.foundingYear),
  slogan: dict.home.seo.title,
  sameAs: activeSocialLinks.map(({ key }) => SITE.social[key]),
};

const website = {
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: SITE.name,
  description: dict.home.seo.description,
  publisher: { '@id': `${siteUrl}/#organization` },
  inLanguage: locale === 'es' ? ['es-HN', 'es'] : ['en-US', 'en'],
};

const professionalService = {
  '@type': 'ProfessionalService',
  '@id': `${siteUrl}/#service`,
  name: SITE.name,
  url: homeUrl,
  image: ogImage,
  description: dict.home.seo.description,
  priceRange: '$$',
  address: organization.address,
  areaServed: organization.areaServed,
  telephone: `+${SITE.whatsapp}`,
};

const softwareApplication = {
  '@type': 'SoftwareApplication',
  '@id': `${healthUrl}/#software`,
  name: SITE.healthName,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Web, iOS, Android',
  url: healthUrl,
  image: new URL(
    (locale === 'en' ? SEO.ogImageHealthEn : SEO.ogImageHealth).replace(/^\//, ''),
    `${siteUrl}/`,
  ).href,
  description: dict.health.seo.description,
  offers: {
    '@type': 'Offer',
    name: dict.health.pricing.planName,
    price: healthPriceRaw,
    priceCurrency: PRICING.currency,
    availability: 'https://schema.org/InStock',
    url: healthUrl,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: healthPriceRaw,
      priceCurrency: PRICING.currency,
      billingDuration: 1,
      billingIncrement: 1,
      unitCode: 'MON',
    },
  },
  provider: { '@id': `${siteUrl}/#organization` },
  featureList: dict.health.modules.items.map((m) => m.title),
  inLanguage: locale === 'es' ? 'es-HN' : 'en-US',
  audience: {
    '@type': 'Audience',
    audienceType: 'Clinics, doctors, medical practices',
    geographicArea: organization.areaServed,
  },
};

const faq =
  page === 'health'
    ? {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name:
              locale === 'es'
                ? '¿Qué es WAKE Health?'
                : 'What is WAKE Health?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: dict.health.seo.description,
            },
          },
          {
            '@type': 'Question',
            name:
              locale === 'es'
                ? '¿WAKE Health funciona en Honduras y Latinoamérica?'
                : 'Does WAKE Health work in Honduras and Latin America?',
            acceptedAnswer: {
              '@type': 'Answer',
              text:
                locale === 'es'
                  ? 'Sí. WAKE Health está diseñado para clínicas en Honduras, Centroamérica, Latinoamérica y también para prácticas en Estados Unidos.'
                  : 'Yes. WAKE Health is built for clinics in Honduras, Central America, Latin America, and practices in the United States.',
            },
          },
          {
            '@type': 'Question',
            name:
              locale === 'es'
                ? '¿Cuánto cuesta WAKE Health?'
                : 'How much does WAKE Health cost?',
            acceptedAnswer: {
              '@type': 'Answer',
              text:
                locale === 'es'
                  ? `WAKE Health tiene un plan único de ${healthPriceLabel} al mes con todos los módulos incluidos, y ${PRICING.trialDays} días de prueba gratuita antes de pagar. Las redes clínicas grandes se cotizan a la medida.`
                  : `WAKE Health has a single plan at ${healthPriceLabel} per month with every module included, plus a ${PRICING.trialDays}-day free trial before paying. Large clinic networks are quoted individually.`,
            },
          },
        ],
      }
    : null;

const graph =
  page === 'home'
    ? [organization, website, professionalService]
    : page === 'health'
      ? [organization, website, softwareApplication, faq].filter(Boolean)
      : [organization, website];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
