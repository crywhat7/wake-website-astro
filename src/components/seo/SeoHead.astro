---
import {
  getAlternateUrls,
  getLocalizedPath,
  ogLocale,
  type Locale,
  type PageKey,
} from '../../i18n';
import { SEO, SITE } from '../../data/site';

interface Props {
  locale: Locale;
  page: PageKey;
  title: string;
  description: string;
  keywords: string;
  image?: string;
  type?: 'website' | 'product' | 'article' | 'profile';
  /** Override canonical path for geo/landing pages */
  canonicalPath?: string;
  placename?: string;
  geoRegionCode?: string;
  hreflang?: string;
  /**
   * Explicit hreflang alternates for pages that exist in both languages but
   * live outside the core `paths` map (landings, hubs, blog posts).
   */
  alternates?: Array<{ hreflang: string; href: string }>;
  /** Skip indexing (used for thin utility pages, none today) */
  noindex?: boolean;
  /** Decide la tarjeta OG por defecto y el theme-color */
  theme?: 'home' | 'health';
  /** Sólo para `type="article"`: fechas ISO y metadatos editoriales */
  publishedTime?: string;
  modifiedTime?: string;
  articleSection?: string;
  /** Etiquetas del artículo; si se omite se derivan de `keywords` */
  articleTags?: string[];
  /** Par etiqueta/valor extra que X muestra bajo la tarjeta */
  twitterLabel1?: string;
  twitterData1?: string;
  twitterLabel2?: string;
  twitterData2?: string;
}

const {
  locale,
  page,
  title,
  description,
  keywords,
  image,
  type = 'website',
  canonicalPath: canonicalPathProp,
  placename,
  geoRegionCode,
  hreflang,
  alternates: alternatesProp,
  noindex = false,
  theme = 'home',
  publishedTime,
  modifiedTime,
  articleSection,
  articleTags,
  twitterLabel1,
  twitterData1,
  twitterLabel2,
  twitterData2,
} = Astro.props;

const siteUrl = (Astro.site?.href ?? SITE.url).replace(/\/$/, '') + '/';
const canonicalPath = canonicalPathProp ?? getLocalizedPath(page, locale);
const canonical = new URL(canonicalPath, siteUrl).href;
const alternates = canonicalPathProp ? [] : getAlternateUrls(page, siteUrl);
const explicitAlternates = (alternatesProp ?? []).map(({ hreflang: hl, href }) => ({
  hreflang: hl,
  href: new URL(href, siteUrl).href,
}));
const xDefault = canonicalPathProp
  ? canonical
  : new URL(getLocalizedPath(page, 'es'), siteUrl).href;
const geoRegion =
  geoRegionCode ??
  (locale === 'es' ? SITE.location.geoRegionEs : SITE.location.geoRegionEn);
const place = placename ?? SITE.location.country;

/* ---------------------------------------------------------------------------
 *  IMAGEN AL COMPARTIR (WhatsApp, Facebook, LinkedIn, X, Telegram, Slack)
 *  ------------------------------------------------------------------------
 *  Tres reglas que, si se rompen, dejan el enlace SIN vista previa:
 *   1. La URL tiene que ser ABSOLUTA. Una ruta `/og/x.png` no le sirve a nadie.
 *   2. Tiene que ser PNG o JPG. WhatsApp y Facebook ignoran SVG y WebP.
 *   3. Debe pesar menos de ~300 KB o WhatsApp no alcanza a descargarla.
 *  Por eso el fallback ya no es el logo SVG (que era invisible al compartir)
 *  sino una tarjeta PNG de 1200x630 generada con `npm run assets`.
 * ------------------------------------------------------------------------ */
const isHealth = theme === 'health' || page === 'health';
const defaultImage = isHealth
  ? locale === 'en'
    ? SEO.ogImageHealthEn
    : SEO.ogImageHealth
  : locale === 'en'
    ? SEO.ogImageEn
    : SEO.ogImage;

/** Convierte cualquier ruta (relativa o absoluta) en URL absoluta del sitio. */
const absolute = (src: string) =>
  /^https?:\/\//i.test(src) ? src : new URL(src.replace(/^\//, ''), siteUrl).href;

const rawImage = image ?? defaultImage;
/** Un SVG pasado a mano se descarta: se compartiría sin miniatura. */
const shareImage = absolute(
  /\.svgz?($|\?)/i.test(rawImage) ? defaultImage : rawImage,
);
/** Sólo conocemos las medidas exactas de nuestras propias tarjetas. */
const isOwnCard = shareImage.includes('/og/');
const squareImage = absolute(
  isHealth ? SEO.ogImageSquareHealth : SEO.ogImageSquare,
);

const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const tags =
  articleTags ??
  keywords
    .split(',')
    .map((k) => k.trim())
    .filter(Boolean)
    .slice(0, 10);

const themeColor = isHealth ? SEO.themeColorHealth : SEO.themeColor;
const host = new URL(siteUrl).host;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="robots" content={robots} />
<meta name="googlebot" content={noindex ? 'noindex, follow' : 'index, follow'} />
<meta name="bingbot" content={robots} />
<meta name="author" content={SITE.name} />
<meta name="publisher" content={SITE.name} />
<meta name="copyright" content={`© ${SITE.copyrightYear} ${SITE.name}`} />
<link rel="canonical" href={canonical} />

{
  !canonicalPathProp && (
    <>
      {alternates.map(({ href, hreflang: hl }) => (
        <link rel="alternate" hreflang={hl} href={href} />
      ))}
      {alternates.map(({ href, locale: loc }) => (
        <link rel="alternate" hreflang={loc} href={href} />
      ))}
      <link rel="alternate" hreflang="x-default" href={xDefault} />
      <link rel="alternate" hreflang="es-MX" href={xDefault} />
      <link rel="alternate" hreflang="es-GT" href={xDefault} />
      <link rel="alternate" hreflang="es-SV" href={xDefault} />
      <link rel="alternate" hreflang="es-CR" href={xDefault} />
      <link rel="alternate" hreflang="es-PA" href={xDefault} />
      <link rel="alternate" hreflang="es-CO" href={xDefault} />
      <link rel="alternate" hreflang="es-US" href={xDefault} />
    </>
  )
}

{
  explicitAlternates.length > 0 && (
    <>
      {explicitAlternates.map(({ href, hreflang: hl }) => (
        <link rel="alternate" hreflang={hl} href={href} />
      ))}
      <link
        rel="alternate"
        hreflang="x-default"
        href={explicitAlternates[0].href}
      />
    </>
  )
}

{
  canonicalPathProp && hreflang && explicitAlternates.length === 0 && (
    <>
      <link rel="alternate" hreflang={hreflang} href={canonical} />
      <link rel="alternate" hreflang={locale} href={canonical} />
    </>
  )
}

{/* ---------- Open Graph: WhatsApp, Facebook, LinkedIn, Telegram ---------- */}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale[locale]} />
<meta
  property="og:locale:alternate"
  content={locale === 'es' ? 'en_US' : 'es_HN'}
/>

{/*
  Para que WhatsApp pinte la tarjeta GRANDE en vez de la miniatura cuadrada
  hacen falta las tres cosas juntas: URL absoluta, ancho y alto declarados.
  `og:image:secure_url` es lo que leen los clientes viejos de WhatsApp/LinkedIn.
*/}
<meta property="og:image" content={shareImage} />
<meta property="og:image:secure_url" content={shareImage} />
<meta property="og:image:alt" content={title} />
{
  isOwnCard && (
    <>
      <meta property="og:image:type" content={SEO.ogImageType} />
      <meta property="og:image:width" content={String(SEO.ogImageWidth)} />
      <meta property="og:image:height" content={String(SEO.ogImageHeight)} />
    </>
  )
}

{/* Segunda imagen 1:1, para los clientes que recortan en cuadrado */}
<meta property="og:image" content={squareImage} />
<meta property="og:image:type" content={SEO.ogImageType} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="1200" />
<meta property="og:image:alt" content={SITE.name} />

{SEO.fbAppId && <meta property="fb:app_id" content={SEO.fbAppId} />}

{
  type === 'article' && (
    <>
      {publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )}
      {(modifiedTime ?? publishedTime) && (
        <meta
          property="article:modified_time"
          content={modifiedTime ?? publishedTime}
        />
      )}
      <meta property="article:author" content={SITE.name} />
      {SEO.fbPage && <meta property="article:publisher" content={SEO.fbPage} />}
      {articleSection && (
        <meta property="article:section" content={articleSection} />
      )}
      {tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

{
  type === 'product' && (
    <>
      <meta property="product:brand" content={SITE.name} />
      <meta property="product:availability" content="in stock" />
      <meta property="product:condition" content="new" />
      <meta
        property="product:price:amount"
        content={SITE.pricing.healthMonthly.toFixed(2)}
      />
      <meta property="product:price:currency" content={SITE.pricing.currency} />
    </>
  )
}

{/* ---------- Twitter / X ------------------------------------------------- */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={shareImage} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:domain" content={host} />
{SEO.twitterSite && <meta name="twitter:site" content={SEO.twitterSite} />}
{
  SEO.twitterCreator && (
    <meta name="twitter:creator" content={SEO.twitterCreator} />
  )
}
{
  twitterLabel1 && twitterData1 && (
    <>
      <meta name="twitter:label1" content={twitterLabel1} />
      <meta name="twitter:data1" content={twitterData1} />
    </>
  )
}
{
  twitterLabel2 && twitterData2 && (
    <>
      <meta name="twitter:label2" content={twitterLabel2} />
      <meta name="twitter:data2" content={twitterData2} />
    </>
  )
}

{/* ---------- Otros lectores (Pinterest, Slack, correo, RSS) -------------- */}
<link rel="image_src" href={shareImage} />
<meta name="thumbnail" content={shareImage} />
<meta itemprop="name" content={title} />
<meta itemprop="description" content={description} />
<meta itemprop="image" content={shareImage} />

{/* ---------- Verificación de propiedad ----------------------------------- */}
{
  SEO.verification.google && (
    <meta name="google-site-verification" content={SEO.verification.google} />
  )
}
{
  SEO.verification.bing && (
    <meta name="msvalidate.01" content={SEO.verification.bing} />
  )
}
{
  SEO.verification.yandex && (
    <meta name="yandex-verification" content={SEO.verification.yandex} />
  )
}
{
  SEO.verification.pinterest && (
    <meta name="p:domain_verify" content={SEO.verification.pinterest} />
  )
}
{
  SEO.verification.facebook && (
    <meta
      name="facebook-domain-verification"
      content={SEO.verification.facebook}
    />
  )
}

{/* ---------- Geo / clasificación ----------------------------------------- */}
<meta name="geo.region" content={geoRegion} />
<meta name="geo.placename" content={place} />
<meta
  name="geo.position"
  content={`${SITE.location.latitude};${SITE.location.longitude}`}
/>
<meta
  name="ICBM"
  content={`${SITE.location.latitude}, ${SITE.location.longitude}`}
/>
<meta name="language" content={locale === 'es' ? 'Spanish' : 'English'} />
<meta name="coverage" content="Honduras, Central America, Latin America, United States" />
<meta name="distribution" content="global" />
<meta name="rating" content="general" />
<meta name="revisit-after" content="3 days" />

<meta name="theme-color" content={themeColor} />
<meta name="msapplication-TileColor" content={themeColor} />
