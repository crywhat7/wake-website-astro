---
import { SEO, SITE } from '../../data/site';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
  headline: string;
  description: string;
  keywords: string;
  /** ISO date, e.g. "2026-07-18" */
  published: string;
  /** Canonical path of this article */
  path: string;
  image?: string;
  section?: string;
}

const {
  locale,
  headline,
  description,
  keywords,
  published,
  path,
  image = SEO.ogImage,
  section,
} = Astro.props;

const siteUrl = (Astro.site?.href ?? SITE.url).replace(/\/$/, '');
const url = new URL(path, `${siteUrl}/`).href;
/* Google exige URL absoluta; las redes además rechazan SVG, por eso el
   fallback es la tarjeta PNG y no el logo vectorial. */
const imageUrl = /^https?:\/\//i.test(image)
  ? image
  : new URL(image.replace(/^\//, ''), `${siteUrl}/`).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  headline,
  description,
  keywords,
  image: {
    '@type': 'ImageObject',
    url: imageUrl,
    width: SEO.ogImageWidth,
    height: SEO.ogImageHeight,
  },
  datePublished: published,
  dateModified: published,
  inLanguage: locale === 'es' ? 'es-HN' : 'en-US',
  ...(section ? { articleSection: section } : {}),
  author: { '@type': 'Organization', name: SITE.name, url: siteUrl },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: new URL('icon-512.png', `${siteUrl}/`).href,
      width: 512,
      height: 512,
    },
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
