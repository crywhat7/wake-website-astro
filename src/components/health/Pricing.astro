---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import MonoTag from '../ui/MonoTag.astro';
import { SITE, whatsappUrl } from '../../data/site';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const pricing = dict.health.pricing;
const enterpriseWa = whatsappUrl(pricing.enterpriseWhatsappMsg);
---

<section id="precios" class="py-32 max-lg:py-20">
  <Container>
    <MonoTag>{pricing.tag}</MonoTag>
    <h2
      class="mb-2 text-[clamp(2rem,4vw,2.75rem)] font-semibold leading-[1.15] tracking-tight text-wake-text"
    >
      {pricing.title}
    </h2>
    <p class="mb-16 max-w-[600px] text-[17px] text-wake-muted">{pricing.subtitle}</p>

    <div class="mt-8 flex justify-center">
      <div
        class="flex w-full max-w-[720px] flex-col rounded-xl border border-wake-text bg-white p-8 shadow-[0_20px_40px_rgba(0,0,0,0.04)] md:p-12"
      >
        <span
          class="mb-4 inline-block w-fit rounded bg-wake-text px-3 py-1 text-xs font-medium text-white"
        >
          {pricing.badge}
        </span>
        <h3 class="mb-2 text-[22px] font-semibold">{pricing.planName}</h3>
        <p class="max-w-[500px] text-[15px] leading-relaxed text-wake-muted">
          {pricing.planDesc}
        </p>
        <div class="my-8 font-mono text-[42px] tracking-tight">
          {pricing.price}<span class="text-base text-wake-muted">{pricing.period}</span>
        </div>

        <div class="mb-8 grid gap-3.5 sm:grid-cols-2 sm:gap-x-[30px]">
          <ul class="flex list-none flex-col gap-2.5">
            {
              pricing.featuresLeft.map((f) => (
                <li class="flex items-center gap-2.5 text-sm text-wake-muted">
                  <i class="fa-solid fa-check text-wake-accent-dark" />
                  {f}
                </li>
              ))
            }
          </ul>
          <ul class="flex list-none flex-col gap-2.5">
            {
              pricing.featuresRight.map((f) => (
                <li class="flex items-center gap-2.5 text-sm text-wake-muted">
                  <i class="fa-solid fa-check text-wake-accent-dark" />
                  {f}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mb-8 flex flex-col gap-1.5 border-t border-wake-border-subtle pt-8">
          <strong class="text-[15px] font-semibold">{pricing.trialTitle}</strong>
          <span class="text-[13px] text-wake-muted">{pricing.trialNote}</span>
        </div>

        <button
          type="button"
          class="paddle-checkout inline-flex max-w-[280px] cursor-pointer items-center justify-center gap-2 rounded-lg border border-wake-text bg-wake-text px-5 py-2.5 text-sm font-medium text-white transition hover:bg-zinc-800"
          data-price-id={SITE.paddle.prices.health}
        >
          {pricing.start}
        </button>
      </div>
    </div>

    <div
      class="mx-auto mt-8 flex w-full max-w-[720px] flex-col gap-4 rounded-xl border border-wake-border bg-wake-card p-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="max-w-[420px]">
        <strong class="mb-1 block text-[15px] font-semibold">{pricing.enterpriseTitle}</strong>
        <p class="text-[13.5px] leading-relaxed text-wake-muted">{pricing.enterpriseNote}</p>
      </div>
      <Button href={enterpriseWa} variant="secondary" target="_blank" rel="noopener noreferrer">
        {pricing.quote}
      </Button>
    </div>
  </Container>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.paddle-checkout').forEach((btn) => {
      btn.addEventListener('click', () => {
        const priceId = btn.getAttribute('data-price-id');
        // @ts-expect-error Paddle CDN
        if (!priceId || typeof Paddle === 'undefined') return;
        // @ts-expect-error Paddle CDN
        Paddle.Checkout.open({
          settings: { displayMode: 'overlay', theme: 'light' },
          items: [{ priceId, quantity: 1 }],
        });
      });
    });
  });
</script>
