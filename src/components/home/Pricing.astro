---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import MonoTag from '../ui/MonoTag.astro';
import { SITE, whatsappUrl } from '../../data/site';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const pricing = dict.home.pricing;

// El CTA prometía "prueba gratuita" y llevaba a un formulario de contacto.
// Ahora apunta al alta real de la aplicación; quien prefiera una demo tiene
// una vía secundaria explícita por WhatsApp.
const demoWa = whatsappUrl(pricing.secondaryWhatsappMsg);
---

<section id="pricing" data-track-section="pricing" class="py-32 max-lg:py-20">
  <Container>
    <MonoTag>{pricing.tag}</MonoTag>
    <h2
      class="mb-2 text-[clamp(2rem,4vw,2.75rem)] font-semibold leading-[1.15] tracking-tight text-wake-text"
    >
      {pricing.title}
    </h2>
    <p class="mb-2 max-w-[600px] text-[17px] text-wake-muted">{pricing.subtitle}</p>
    <p class="mb-16 max-w-[600px] text-[15px] text-wake-light">{pricing.audienceNote}</p>

    <div class="mt-8 flex justify-center">
      <div
        class="flex w-full max-w-[720px] flex-col rounded-xl border border-wake-text bg-white p-8 shadow-[0_20px_40px_rgba(0,0,0,0.04)] md:p-12"
      >
        <span
          class="mb-4 inline-block w-fit rounded bg-wake-text px-3 py-1 text-xs font-medium text-white"
        >
          {pricing.badge}
        </span>
        <h3 class="mb-2 text-[22px] font-semibold">{pricing.planName}</h3>
        <p class="max-w-[500px] text-[15px] leading-relaxed text-wake-muted">
          {pricing.planDesc}
        </p>
        <div class="my-8 font-mono text-[42px]">
          {pricing.price}<span class="text-base text-wake-muted">{pricing.period}</span>
        </div>

        <div class="mb-8 grid gap-3.5 sm:grid-cols-2 sm:gap-x-[30px]">
          <ul class="flex list-none flex-col gap-2.5">
            {
              pricing.featuresLeft.map((f) => (
                <li class="flex items-center gap-2.5 text-sm text-wake-muted">
                  <i class="fa-solid fa-check text-wake-accent-dark" />
                  {f}
                </li>
              ))
            }
          </ul>
          <ul class="flex list-none flex-col gap-2.5">
            {
              pricing.featuresRight.map((f) => (
                <li class="flex items-center gap-2.5 text-sm text-wake-muted">
                  <i class="fa-solid fa-check text-wake-accent-dark" />
                  {f}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mb-8 flex flex-col gap-1.5 border-t border-wake-border-subtle pt-8">
          <strong class="text-[15px] font-semibold">{pricing.trialTitle}</strong>
          <span class="text-[13px] text-wake-muted">{pricing.trialNote}</span>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <Button
            href={SITE.healthAppSignup}
            target="_blank"
            rel="noopener noreferrer"
            cta="start_trial"
            ctaLocation="pricing"
          >
            {pricing.cta}
            <i class="fa-solid fa-arrow-right text-[11px]"></i>
          </Button>
          <Button
            href={demoWa}
            target="_blank"
            rel="noopener noreferrer"
            variant="secondary"
            cta="request_demo"
            ctaLocation="pricing"
          >
            {pricing.secondaryCta}
            <i class="fa-brands fa-whatsapp text-sm"></i>
          </Button>
        </div>
        <p class="mt-3 text-[13px] text-wake-light">{pricing.ctaNote}</p>

        <p class="mt-6 flex items-start gap-2.5 border-t border-wake-border-subtle pt-6 text-[13px] leading-relaxed text-wake-muted">
          <i class="fa-solid fa-shield-halved mt-0.5 text-wake-accent-dark"></i>
          {pricing.guarantee}
        </p>
      </div>
    </div>
  </Container>
</section>
