---
import Container from '../ui/Container.astro';
import MonoTag from '../ui/MonoTag.astro';
import { t, getLocalizedPath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  /** Permite a las páginas geo apuntar al /health de su región. */
  healthHref?: string;
}

const { locale, healthHref } = Astro.props;
const dict = t(locale);
const healthPath = healthHref ?? getLocalizedPath('health', locale);

// El homepage recibe dos intenciones muy distintas (clínicas vs. resto de
// empresas). Este bloque las separa temprano en lugar de obligar a cada
// visitante a leer la mitad de la página que no le corresponde.
const hrefFor = (target: string) => (target === 'health' ? healthPath : '#contact');
---

<section
  id="audience"
  data-track-section="audience"
  class="border-b border-wake-border-subtle py-20 max-lg:py-14"
>
  <Container>
    <MonoTag>{dict.home.audience.tag}</MonoTag>
    <h2
      class="mb-2 text-[clamp(1.75rem,3.4vw,2.25rem)] font-semibold leading-[1.15] tracking-tight text-wake-text"
    >
      {dict.home.audience.title}
    </h2>
    <p class="mb-10 max-w-[600px] text-[17px] text-wake-muted">{dict.home.audience.subtitle}</p>

    <div class="grid gap-4 md:grid-cols-2">
      {
        dict.home.audience.options.map((option) => (
          <a
            href={hrefFor(option.target)}
            data-cta={`audience_${option.target}`}
            data-cta-location="audience_router"
            class="group flex flex-col rounded-xl border border-wake-border bg-white p-8 no-underline transition hover:-translate-y-0.5 hover:border-wake-text hover:shadow-[0_12px_30px_rgba(0,0,0,0.05)]"
          >
            <i class={`fa-solid ${option.icon} mb-4 text-xl text-wake-text`} />
            <h3 class="mb-2 text-[19px] font-semibold tracking-tight text-wake-text">
              {option.title}
            </h3>
            <p class="mb-6 text-[15px] leading-relaxed text-wake-muted">{option.desc}</p>
            <span class="mt-auto inline-flex items-center gap-2 text-sm font-medium text-wake-text">
              {option.cta}
              <i class="fa-solid fa-arrow-right text-[11px] transition group-hover:translate-x-1" />
            </span>
          </a>
        ))
      }
    </div>
  </Container>
</section>
