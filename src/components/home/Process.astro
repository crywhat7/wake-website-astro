---
import Container from '../ui/Container.astro';
import MonoTag from '../ui/MonoTag.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<section class="border-y border-wake-border bg-wake-subtle py-32 max-lg:py-20">
  <Container>
    <MonoTag>{dict.home.process.tag}</MonoTag>
    <h2
      class="wake-h2 mb-3 text-wake-text" data-reveal
    >
      {dict.home.process.title}
    </h2>
    <p class="mb-16 max-w-[620px] text-[17px] leading-relaxed text-wake-muted" data-reveal>{dict.home.process.subtitle}</p>

    <div class="mt-8 grid gap-12 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group="130">
      {
        dict.home.process.steps.map((s) => (
          <div data-reveal class="border-t border-wake-border pt-6">
            <span class="wake-label mb-4 block text-wake-accent-deep">{s.num}</span>
            <h3 class="mb-2 text-[18px] font-semibold tracking-[-0.02em]">{s.title}</h3>
            <p class="text-[14px] leading-relaxed text-wake-muted">{s.desc}</p>
          </div>
        ))
      }
    </div>
  </Container>
</section>
