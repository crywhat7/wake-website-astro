---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import MonoTag from '../ui/MonoTag.astro';
import { SITE } from '../../data/site';
import { t, getLocalizedPath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  tag?: string;
  subtitle?: string;
  healthHref?: string;
}

const { locale, tag, subtitle, healthHref } = Astro.props;
const dict = t(locale);
const healthPath = healthHref ?? getLocalizedPath('health', locale);
const heroTag = tag ?? dict.home.hero.tag;
const heroSubtitle = subtitle ?? dict.home.hero.subtitle;

// Captura real del producto en lugar de un mockup de relleno: es el activo de
// confianza más valioso de la página y ya existe en `SITE.assets.gallery`.
const heroShot = SITE.assets.gallery[0].src;
---

<section id="hero" class="relative overflow-hidden pb-32 pt-[calc(4rem+8rem)] max-lg:pb-20 max-lg:pt-28">
  <Container class="grid items-center gap-16 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <MonoTag>{heroTag}</MonoTag>
      <h1
        class="mb-4 text-[clamp(2.5rem,4.6vw,3.75rem)] font-semibold leading-[1.05] tracking-[-0.04em] text-wake-text"
      >
        {dict.home.hero.titleBefore}
        <br />
        <strong class="wake-gradient-text font-semibold">
          {dict.home.hero.titleAccent}
        </strong>
      </h1>
      <p class="mb-8 max-w-[560px] text-lg font-light leading-relaxed text-wake-muted">
        {heroSubtitle}
      </p>
      <div class="flex flex-wrap gap-4">
        <Button href="#contact" cta="book_diagnostic" ctaLocation="hero">
          {dict.home.hero.ctaPrimary}
          <i class="fa-solid fa-arrow-right text-[11px]"></i>
        </Button>
        <Button href={healthPath} variant="secondary" cta="view_health" ctaLocation="hero">
          {dict.home.hero.ctaSecondary}
        </Button>
      </div>
      <p class="mt-4 text-[13px] text-wake-light">{dict.home.hero.note}</p>
    </div>

    <div class="relative mx-auto flex w-full max-w-[540px] flex-col justify-center lg:order-none max-lg:order-first">
      <div
        class="relative w-full rounded-xl border border-wake-border bg-white p-2 shadow-[0_20px_40px_rgba(0,0,0,0.06)]"
      >
        <img
          src={heroShot}
          alt={dict.home.hero.imageAlt}
          width="1080"
          height="720"
          fetchpriority="high"
          decoding="async"
          class="w-full rounded-lg border border-wake-border-subtle object-cover"
        />
        <div
          class="absolute -bottom-5 -left-5 flex items-center gap-2 rounded-lg bg-wake-text px-4 py-2.5 font-mono text-[11px] text-white shadow-[0_10px_20px_rgba(0,0,0,0.1)] max-sm:left-0"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-wake-accent-dark"></span>
          {dict.home.hero.badge}
        </div>
      </div>
      <p class="mt-8 font-mono text-[10px] leading-relaxed text-wake-light">
        {dict.home.products.illustrationNote}
      </p>
    </div>
  </Container>
</section>
