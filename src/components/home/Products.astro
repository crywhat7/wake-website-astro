---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import MonoTag from '../ui/MonoTag.astro';
import { SITE } from '../../data/site';
import { t, getLocalizedPath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const healthPath = getLocalizedPath('health', locale);
---

<section id="products" data-track-section="products" class="py-32 max-lg:py-20">
  <Container>
    <MonoTag>{dict.home.products.tag}</MonoTag>
    <h2
      class="wake-h2 mb-3 text-wake-text" data-reveal
    >
      {dict.home.products.title}
    </h2>
    <p class="mb-16 max-w-[620px] text-[17px] leading-relaxed text-wake-muted" data-reveal>{dict.home.products.subtitle}</p>

    <div
      class="relative overflow-hidden rounded-xl border border-wake-border bg-wake-card p-8 md:p-12"
    >
      <div
        class="pointer-events-none absolute top-0 right-0 z-[1] h-[150px] w-[150px] bg-[radial-gradient(circle,rgba(173,252,220,0.4)_0%,transparent_70%)]"
      >
      </div>

      <div class="relative z-[2] max-w-[640px]">
        <div class="mb-4 h-[180px] md:h-[220px]">
          <img
            src={SITE.assets.healthLogoSvg}
            alt={dict.home.products.logoAlt}
            class="h-full w-auto object-contain"
            loading="lazy"
            width="400"
            height="220"
          />
        </div>
        <h3 class="mb-2 text-2xl font-semibold tracking-tight">{dict.home.products.healthTitle}</h3>
        <p class="mb-8 text-[15px] leading-relaxed text-wake-muted">
          {dict.home.products.healthDesc}
        </p>
        <Button href={healthPath} variant="secondary" cta="view_health" ctaLocation="products">
          {dict.home.products.healthCta}
          <i class="fa-solid fa-arrow-up-right-from-square ml-1 text-[11px]"></i>
        </Button>
      </div>

      <div class="relative z-[2] mt-12 border-t border-wake-border pt-10">
        <h4 class="mb-6 font-mono text-[11px] tracking-[0.14em] text-wake-light uppercase">
          {dict.home.products.featuresTitle}
        </h4>
        <ul class="grid list-none gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            dict.home.products.features.map((feature) => (
              <li class="rounded-lg border border-wake-border bg-white p-5 transition hover:border-zinc-300">
                <span class="mb-3 inline-flex h-9 w-9 items-center justify-center rounded-md bg-wake-accent/40 text-wake-text">
                  <i class={`fa-solid ${feature.icon} text-[13px]`} />
                </span>
                <h5 class="mb-1.5 text-[15px] font-semibold tracking-tight text-wake-text">
                  {feature.title}
                </h5>
                <p class="text-[13.5px] leading-relaxed text-wake-muted">{feature.desc}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</section>
