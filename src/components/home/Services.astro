---
import Container from '../ui/Container.astro';
import MonoTag from '../ui/MonoTag.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<section
  id="services"
  data-track-section="services"
  class="border-y border-wake-border bg-wake-subtle py-32 max-lg:py-20"
>
  <Container>
    <MonoTag>{dict.home.services.tag}</MonoTag>
    <h2
      class="wake-h2 mb-3 text-wake-text" data-reveal
    >
      {dict.home.services.title}
    </h2>
    <p class="mb-16 max-w-[620px] text-[17px] leading-relaxed text-wake-muted" data-reveal>
      {dict.home.services.subtitle}
    </p>

    <div
      class="mt-8 grid border-t border-l border-wake-border sm:grid-cols-2 lg:grid-cols-3"
      data-reveal-group="70"
    >
      {
        dict.home.services.items.map((item) => (
          <article
            data-reveal
            class="group relative border-r border-b border-wake-border bg-white p-8 transition-colors duration-500 ease-expo-out hover:bg-wake-card md:p-12 md:px-8"
          >
            {/* Barra de acento que crece desde la izquierda al pasar el cursor. */}
            <span
              class="absolute bottom-0 left-0 h-[3px] w-0 bg-wake-accent-dark transition-[width] duration-700 ease-expo-out group-hover:w-full"
              aria-hidden="true"
            />
            <i
              class={`fa-solid ${item.icon} mb-5 text-lg text-wake-light transition-colors duration-500 ease-expo-out group-hover:text-wake-accent-dark`}
            />
            <h3 class="mb-2 text-[17px] font-semibold tracking-[-0.02em]">{item.title}</h3>
            <p class="text-[14px] leading-relaxed text-wake-muted">{item.desc}</p>
          </article>
        ))
      }
    </div>
  </Container>
</section>
