---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import MonoTag from '../ui/MonoTag.astro';
import { SITE, whatsappUrl } from '../../data/site';
import { t, getLocalizedPath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const contact = dict.home.contact;
const privacyHref = `${getLocalizedPath('legal', locale)}#privacy`;
const wa = whatsappUrl(contact.whatsappMsg);
---

<section
  id="contact"
  data-track-section="contact"
  class="border-t border-wake-border-subtle py-32 max-lg:py-20"
>
  <Container class="grid gap-16 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <MonoTag>{contact.tag}</MonoTag>
      <h2
        class="wake-h2 mb-3 text-wake-text" data-reveal
      >
        {contact.title}
      </h2>
      <p class="mb-8 max-w-[600px] text-[17px] text-wake-muted">{contact.subtitle}</p>

      <p class="mb-6 flex items-center gap-2.5 text-[14px] text-wake-muted">
        <i class="fa-regular fa-clock text-wake-accent-dark"></i>
        {contact.responseNote}
      </p>

      {/* WhatsApp es el canal preferido en HN/LATAM: se ofrece como alternativa
          visible al formulario, no escondido en el pie de página. */}
      <div class="rounded-xl border border-wake-border bg-wake-subtle p-6">
        <p class="mb-3 text-[13px] text-wake-light">{contact.orLabel}</p>
        <div class="flex flex-col gap-3">
          <Button
            href={wa}
            target="_blank"
            rel="noopener noreferrer"
            variant="secondary"
            class="w-fit"
            cta="whatsapp"
            ctaLocation="contact"
          >
            {contact.whatsappCta}
            <i class="fa-brands fa-whatsapp text-sm"></i>
          </Button>
          <a
            href={`mailto:${SITE.email}`}
            data-cta="email"
            data-cta-location="contact"
            class="inline-flex min-h-[44px] items-center text-[13px] text-wake-muted no-underline transition-colors duration-500 ease-expo-out hover:text-wake-text"
          >
            <i class="fa-regular fa-envelope mr-1.5"></i>
            {SITE.email}
          </a>
        </div>
      </div>
    </div>

    <form
      id="contactForm"
      class="flex flex-col gap-4"
      data-email={SITE.email}
      data-subject={contact.mailSubject}
      data-sending={contact.sending}
      data-success={contact.success}
      data-error={contact.error}
      data-submit-label={contact.submit}
    >
      {/* Honeypot anti-spam */}
      <input
        type="text"
        name="_gotcha"
        tabindex="-1"
        autocomplete="off"
        class="absolute -left-[9999px] h-0 w-0 opacity-0"
        aria-hidden="true"
      />
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="flex flex-col gap-1.5">
          <label for="name" class="text-xs font-medium text-wake-muted">{contact.name}</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            class="rounded-lg border border-wake-border bg-white px-3.5 py-2.5 text-sm text-wake-text transition focus:border-wake-text focus:shadow-[0_0_0_1px_#0c0c0d] focus:outline-none"
          />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="company" class="text-xs font-medium text-wake-muted">{contact.company}</label>
          <input
            type="text"
            id="company"
            name="company"
            autocomplete="organization"
            class="rounded-lg border border-wake-border bg-white px-3.5 py-2.5 text-sm text-wake-text transition focus:border-wake-text focus:shadow-[0_0_0_1px_#0c0c0d] focus:outline-none"
          />
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="flex flex-col gap-1.5">
          <label for="email" class="text-xs font-medium text-wake-muted">{contact.email}</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="rounded-lg border border-wake-border bg-white px-3.5 py-2.5 text-sm text-wake-text transition focus:border-wake-text focus:shadow-[0_0_0_1px_#0c0c0d] focus:outline-none"
          />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="phone" class="text-xs font-medium text-wake-muted">{contact.phone}</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            autocomplete="tel"
            class="rounded-lg border border-wake-border bg-white px-3.5 py-2.5 text-sm text-wake-text transition focus:border-wake-text focus:shadow-[0_0_0_1px_#0c0c0d] focus:outline-none"
          />
        </div>
      </div>
      <div class="flex flex-col gap-1.5">
        <label for="message" class="text-xs font-medium text-wake-muted">{contact.message}</label>
        {/* Campo opcional a propósito: exigirlo era el principal punto de abandono. */}
        <textarea
          id="message"
          name="message"
          rows="4"
          class="min-h-[100px] resize-y rounded-lg border border-wake-border bg-white px-3.5 py-2.5 text-sm text-wake-text transition focus:border-wake-text focus:shadow-[0_0_0_1px_#0c0c0d] focus:outline-none"
        ></textarea>
      </div>
      <p id="contactStatus" class="hidden text-sm" role="status" aria-live="polite"></p>
      <Button
        type="submit"
        id="contactSubmit"
        class="mt-2 self-start !px-6 !py-3"
        cta="submit_lead_form"
        ctaLocation="contact"
      >
        {contact.submit}
      </Button>
      <p class="text-[12px] leading-relaxed text-wake-light">
        {contact.privacyNote}{' '}
        <a href={privacyHref} class="text-wake-muted underline hover:text-wake-text">
          {contact.privacyLink}
        </a>
      </p>
    </form>
  </Container>
</section>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const statusEl = document.getElementById('contactStatus');
  const submitBtn = document.getElementById('contactSubmit') as HTMLButtonElement | null;

  const track = (event: string, params: Record<string, unknown> = {}) => {
    (window as unknown as { wakeTrack?: (e: string, p?: unknown) => void }).wakeTrack?.(
      event,
      params
    );
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !submitBtn) return;

    const toEmail = form.dataset.email ?? '';
    const subjectBase = form.dataset.subject ?? 'Contacto WAKE';
    const sendingLabel = form.dataset.sending ?? '…';
    const successLabel = form.dataset.success ?? 'OK';
    const errorLabel = form.dataset.error ?? 'Error';
    const submitLabel = form.dataset.submitLabel ?? 'Send';

    const honeypot = (form.querySelector('[name="_gotcha"]') as HTMLInputElement | null)?.value;
    if (honeypot) return;

    const name = (document.getElementById('name') as HTMLInputElement).value.trim();
    const company = (document.getElementById('company') as HTMLInputElement).value.trim();
    const userEmail = (document.getElementById('email') as HTMLInputElement).value.trim();
    const phone = (document.getElementById('phone') as HTMLInputElement).value.trim();
    const message = (document.getElementById('message') as HTMLTextAreaElement).value.trim();

    submitBtn.disabled = true;
    submitBtn.textContent = sendingLabel;
    if (statusEl) {
      statusEl.className = 'text-sm text-wake-muted';
      statusEl.textContent = sendingLabel;
      statusEl.classList.remove('hidden');
    }

    try {
      const res = await fetch(`https://formsubmit.co/ajax/${encodeURIComponent(toEmail)}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify({
          name,
          company,
          email: userEmail,
          phone,
          message,
          _subject: `${subjectBase} - ${name}`,
          _template: 'table',
          _captcha: 'false',
          _replyto: userEmail,
        }),
      });

      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = (await res.json()) as { success?: string | boolean };
      if (!data.success) throw new Error('FormSubmit rejected');

      form.reset();
      track('generate_lead', { form_id: 'contact', has_phone: Boolean(phone) });
      if (statusEl) {
        statusEl.className = 'text-sm text-emerald-700';
        statusEl.textContent = successLabel;
      }
    } catch (error) {
      track('form_error', {
        form_id: 'contact',
        reason: error instanceof Error ? error.message : 'unknown',
      });
      if (statusEl) {
        statusEl.className = 'text-sm text-red-600';
        statusEl.textContent = errorLabel;
      }
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = submitLabel;
    }
  });
</script>
