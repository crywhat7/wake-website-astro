---
import '../../styles/global.css';
import Analytics from './Analytics.astro';
import Motion from './Motion.astro';
import SeoHead from '../seo/SeoHead.astro';
import JsonLd from '../seo/JsonLd.astro';
import type { Locale, PageKey } from '../../i18n';

interface Props {
  locale: Locale;
  page: PageKey;
  title: string;
  description: string;
  keywords: string;
  image?: string;
  theme?: 'home' | 'health';
  canonicalPath?: string;
  placename?: string;
  geoRegionCode?: string;
  hreflang?: string;
  alternates?: Array<{ hreflang: string; href: string }>;
  noindex?: boolean;
}

const {
  locale,
  page,
  title,
  description,
  keywords,
  image,
  theme = 'home',
  canonicalPath,
  placename,
  geoRegionCode,
  hreflang,
  alternates,
  noindex,
} = Astro.props;

/*
 * Poppins es la tipografía de marca, una sola para todo el sitio.
 *
 * Antes esta constante bifurcaba por `theme`: la rama "health" pedía Poppins y
 * la rama "home" pedía Inter + Geist Mono. Como TODAS las páginas (incluidas
 * las de /health) pasaban theme="home", la rama de Poppins nunca se ejecutaba y
 * la fuente jamás llegó a cargarse en el sitio. Lo que se veía era Geist Mono
 * en los elementos con `font-mono`, que se leía como un fallback roto.
 *
 * Una sola familia elimina la bifurcación, el bug y una petición de red.
 */
const fontHref =
  'https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap';

const htmlLang = hreflang ?? (locale === 'es' ? 'es-HN' : 'en-US');
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fontHref} />
    <link href={fontHref} rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <SeoHead
      locale={locale}
      page={page}
      title={title}
      description={description}
      keywords={keywords}
      image={image}
      canonicalPath={canonicalPath}
      placename={placename}
      geoRegionCode={geoRegionCode}
      hreflang={hreflang}
      alternates={alternates}
      noindex={noindex}
    />
    <JsonLd locale={locale} page={page} />
    <Analytics />
    <Motion />
  </head>
  <body data-theme={theme}>
    <slot />
  </body>
</html>
