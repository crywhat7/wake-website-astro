---
import '../../styles/global.css';
import Analytics from './Analytics.astro';
import Motion from './Motion.astro';
import SeoHead from '../seo/SeoHead.astro';
import JsonLd from '../seo/JsonLd.astro';
import { SEO, SITE } from '../../data/site';
import type { Locale, PageKey } from '../../i18n';

interface Props {
  locale: Locale;
  page: PageKey;
  title: string;
  description: string;
  keywords: string;
  image?: string;
  theme?: 'home' | 'health';
  canonicalPath?: string;
  placename?: string;
  geoRegionCode?: string;
  hreflang?: string;
  alternates?: Array<{ hreflang: string; href: string }>;
  noindex?: boolean;
  /** Tipo Open Graph: 'article' en el blog, 'product' en WAKE Health */
  ogType?: 'website' | 'product' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  articleSection?: string;
  articleTags?: string[];
  twitterLabel1?: string;
  twitterData1?: string;
  twitterLabel2?: string;
  twitterData2?: string;
}

const {
  locale,
  page,
  title,
  description,
  keywords,
  image,
  theme = 'home',
  canonicalPath,
  placename,
  geoRegionCode,
  hreflang,
  alternates,
  noindex,
  ogType,
  publishedTime,
  modifiedTime,
  articleSection,
  articleTags,
  twitterLabel1,
  twitterData1,
  twitterLabel2,
  twitterData2,
} = Astro.props;

/*
 * Poppins es la tipografía de marca, una sola para todo el sitio.
 *
 * Antes esta constante bifurcaba por `theme`: la rama "health" pedía Poppins y
 * la rama "home" pedía Inter + Geist Mono. Como TODAS las páginas (incluidas
 * las de /health) pasaban theme="home", la rama de Poppins nunca se ejecutaba y
 * la fuente jamás llegó a cargarse en el sitio. Lo que se veía era Geist Mono
 * en los elementos con `font-mono`, que se leía como un fallback roto.
 *
 * Una sola familia elimina la bifurcación, el bug y una petición de red.
 */
const fontHref =
  'https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap';

const htmlLang = hreflang ?? (locale === 'es' ? 'es-HN' : 'en-US');
const rssPath = locale === 'en' ? '/en/rss.xml' : '/rss.xml';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    {/*
      Iconos. Todos salen de `public/favicon.svg` vía `npm run assets`.
      El .ico multi-resolución existe porque Windows, varios lectores RSS y
      algunos rastreadores lo piden por la ruta fija /favicon.ico y, si no
      está, registran un 404 en cada visita.
    */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/favicon.svg" color={SEO.themeColor} />
    <meta name="application-name" content={SITE.name} />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    {/* Evita que iOS convierta teléfonos y direcciones en enlaces con estilo
        propio, que rompen la maquetación. */}
    <meta name="format-detection" content="telephone=no,address=no,email=no" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    {/* Las capturas e imágenes del sitio viven en R2; resolver el DNS por
        adelantado recorta el LCP, que sí pesa en el ranking. */}
    <link
      rel="dns-prefetch"
      href="https://pub-f6d32fe4d40f4f899fa753aab8eb28d5.r2.dev"
    />
    <link
      rel="dns-prefetch"
      href="https://pub-c91a757ecc0647fc9f8436786c936eff.r2.dev"
    />
    <link rel="preload" as="style" href={fontHref} />
    <link href={fontHref} rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} — Blog`}
      href={rssPath}
    />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <SeoHead
      locale={locale}
      page={page}
      title={title}
      description={description}
      keywords={keywords}
      image={image}
      theme={theme}
      type={ogType}
      canonicalPath={canonicalPath}
      placename={placename}
      geoRegionCode={geoRegionCode}
      hreflang={hreflang}
      alternates={alternates}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      articleSection={articleSection}
      articleTags={articleTags}
      twitterLabel1={twitterLabel1}
      twitterData1={twitterData1}
      twitterLabel2={twitterLabel2}
      twitterData2={twitterData2}
    />
    <JsonLd locale={locale} page={page} />
    <Analytics />
    <Motion />
  </head>
  <body data-theme={theme}>
    <slot />
  </body>
</html>
